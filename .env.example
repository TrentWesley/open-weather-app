# Copy this file to .env and replace the placeholder values.
# Never commit .env or put real keys in this file.

# Required
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
OPENWEATHER_API_KEY=replace-with-your-openweather-api-key

# Optional (defaults shown in comments)
# Set to true for local development; defaults to false.
DJANGO_DEBUG=false
# Comma-separated host names; defaults to localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Send cookies over HTTPS only; defaults to the opposite of DJANGO_DEBUG.
DJANGO_SECURE_COOKIES=true
# Set to true only with a One Call API 3.0 subscription (enables UV index).
OPENWEATHER_ENABLE_ONECALL=false
